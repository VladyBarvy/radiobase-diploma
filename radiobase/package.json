{
  "name": "radiobase",
  "version": "1.0.0",
  "description": "Portable database for electronic components",
  "main": "./out/main/index.js",
  "author": "barvv",
  "homepage": "https://github.com/VladyBarvy/radiobase-diploma/tree/eight",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:portable": "npm run build && electron-builder --win --config.artifactName=RadioBase-Portable.exe --config.win.target=portable",
    "build:win:installer": "npm run build && electron-builder --win --config.win.target=nsis",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder --win --publish=never",
    "test": "playwright test",
    "test:ui": "playwright test tests/specs/universal-ui-test.spec.js --ui",
    "test:ui-all": "playwright test tests/specs/ --ui",
    "test:ui-fixed": "playwright test tests/specs/ui-mode-fixed.spec.js --ui",
    "test:headed": "playwright test tests/specs/universal-ui-test.spec.js --headed",
    "test:debug": "playwright test tests/specs/universal-ui-test.spec.js --debug",
    "test:load": "playwright test tests/load-test.spec.js",
    "test:load:real": "node tests/real-db-load-test.js",
    "test:memory": "playwright test tests/memory-test.spec.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "react-icons": "^5.5.0",
    "sql.js": "^1.10.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.6"
  },
  "build": {
    "appId": "com.example.radiobase",
    "productName": "RadioBase",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": false,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon_3.ico"
    },
    "portable": {
      "artifactName": "RadioBase.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  }
}
